{
  "name": "dsh-for-bio",
  "version": "1.3.3",
  "private": false,
  "description": "Connect to preclinical research tools and databases (literature search, genomics analysis, target prioritization) to accelerate early-stage life sciences R&D",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills",
    "README.md",
    "CONNECTORS.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "Apache-2.0",
  "author": "Miyamiz39",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bio-research",
    "mcp",
    "literature",
    "pubmed",
    "biorxiv",
    "consensus",
    "chembl",
    "opentargets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miyamiz39/dsh-for-bio.git"
  },
  "homepage": "https://github.com/Miyamiz39/dsh-for-bio#readme",
  "bugs": {
    "url": "https://github.com/Miyamiz39/dsh-for-bio/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
